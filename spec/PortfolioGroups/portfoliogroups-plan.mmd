---
config:
  layout: dagre
---
flowchart TB
    ChangedFile["Changed file input portfolio groups JSON"] --> Parser["PortfolioGroupFileParsingStrategy"]
    Parser --> GroupList["CreatePortfolioGroupRequest list"]
    GroupList --> Entries["Individual portfolio group entries"]
    Entries --> Compare["Compare entry vs persisted code"]
    Entries --> Key["deriveKey (scope/code)"]
    Key -- key --> StateStore["CosmosStateRepository type=PORTFOLIO_GROUP"]
    StateStore --> ExistingPayload["ExistingPayload"]
    ExistingPayload --> Compare
    Compare -- new --> EmitNew["NEW plan item"]
    Compare -- changed --> EmitUpdate["UPDATE plan item"]
    Compare -- missing --> EmitDelete["DELETE plan item"]
