flowchart TB
    ChangedFile["Changed file input ABOR JSON"] --> Parser["AborFileParsingStrategy"]
    Parser --> Entries["AborRequest entries"]
    Entries --> Compare["Compare entry vs state"]
    Entries --> Key["deriveKey (scope/code)"]
    Key -- key --> StateStore["CosmosStateRepository type=ABOR"]
    StateStore --> ExistingPayload["ExistingPayload"]
    ExistingPayload --> Compare
    Compare -- new --> EmitNew["NEW plan item"]
    Compare -- changed --> EmitUpdate["UPDATE plan item"]
    Compare -- missing --> EmitDelete["DELETE plan item"]
